# URL base de la Presto API (sin barra final).
# Backend local: http://localhost:8000/api/v1
# Mock local (pnpm mock): http://localhost:8001/api/v1
#
# Usá `localhost` en los dos lados (front y API): la cookie httpOnly del refresh
# es del mismo sitio y así viaja. Si el front corre en `localhost` y la API en
# `127.0.0.1`, el navegador las considera sitios distintos y el refresh falla.
VITE_API_URL=http://localhost:8000/api/v1

# Asistente "Presti": implementado en el backend (`apps/assistant`), sin LLM.
# Se puede ocultar con VITE_ENABLE_ASSISTANT=false.
VITE_ENABLE_ASSISTANT=true

# Recordatorio interno de revisión legal.
# "true" lo oculta siempre; "demo" lo oculta cuando la API responde mode=demo
# (por defecto en el material de pitch).
VITE_HIDE_COMPLIANCE_BANNER=false

# Fuerza el recordatorio aunque la API esté en modo demo (solo para desarrollo).
VITE_SHOW_COMPLIANCE_BANNER=false
