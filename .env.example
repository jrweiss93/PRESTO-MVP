# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL 16)
DATABASE_URL=postgres://presto:presto@localhost:5432/presto
# Alternatively, individual variables:
# POSTGRES_DB=presto
# POSTGRES_USER=presto
# POSTGRES_PASSWORD=presto
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
# Celery broker: defaults to REDIS_URL when not set
CELERY_BROKER_URL=redis://localhost:6379/0

# Modo demo: con DEMO_MODE=true la aplicación corre como demostración (el
# dinero es simulado y los avisos de las notificaciones salen por consola, en
# los logs del worker). Sin DEMO_MODE, el dinero simulado queda bloqueado por
# el system check ledger.E001.
DEMO_MODE=false

# Depósitos y retiros simulados: con LEDGER_SIMULATED_DEPOSITS_ENABLED=true se
# puede mover dinero simulado. En producción tiene que quedar apagado (salvo
# en modo demo) y el system check ledger.E001 lo impide.
LEDGER_SIMULATED_DEPOSITS_ENABLED=false

# Email: en modo demo los avisos de las notificaciones salen por consola, en los
# logs del worker (`docker compose logs -f worker`). Definí EMAIL_HOST para usar
# un SMTP de verdad.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@presto.local

# URL del front: con ella se arman los enlaces de los correos (reseteo de
# contraseña y verificación de email). En la demo local es Vite.
FRONTEND_URL=http://localhost:5173

# Segundos de validez de esos enlaces (1 hora por defecto).
PASSWORD_RESET_TIMEOUT=3600

# CORS: los orígenes del front, separados por comas. La lista se lee en
# `CORS_ALLOWED_ORIGINS`; vacío significa que ningún origen puede llamar a la
# API y nunca se usa `*`.
# Con el front de Vite en localhost:5173, el origen va acá (o el 5173 del
# `pnpm dev`): la API responde con credenciales (el refresh viaja en cookie
# httpOnly) y permite el header `Idempotency-Key`.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Refresh token en cookie httpOnly (ADR 0014). El nombre, el path y el SameSite
# de la cookie; `Secure` va siempre activa en producción y se fuerza ahí, así
# que acá solo hace falta si el front HTTPS no usa el dominio de la API.
JWT_REFRESH_COOKIE_NAME=presto_refresh
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax

# Reintentos de los avisos por email (ADR 0013): la base del backoff
# exponencial, en segundos. El primer reintento espera la base y el siguiente
# el doble.
NOTIFICATIONS_RETRY_BASE_SECONDS=60

# Proveedor de pagos (ADR 0008). `simulated` no llama a nadie: mueve el saldo
# de inmediato y sirve para el modo demo y los tests. `mercadopago` habla con
# la API real y necesita credenciales.
PAYMENTS_PROVIDER=simulated
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
# URL pública a la que Mercado Pago manda los avisos. En local no hay túnel:
# sin esta variable, el proveedor real no puede crear preferencias de pago.
MERCADO_PAGO_WEBHOOK_URL=
# Antigüedad máxima aceptada en la firma de un webhook (en segundos) y timeout
# de las llamadas HTTP al proveedor.
PAYMENTS_WEBHOOK_MAX_AGE_SECONDS=300
PAYMENTS_HTTP_TIMEOUT=10

# Sentry (opcional): la variable queda documentada, pero hoy la aplicación no
# la lee (no está instalado sentry-sdk).
SENTRY_DSN=https://o0.ingest.sentry.io/0

# Environment
DJANGO_ENV=production

# Revisión legal y de PLA/FT: recordatorio. Mientras esté en false, el
# endpoint `/api/v1/meta/` informa que la revisión sigue pendiente y el system
# check `legal.W001` avisa en `manage.py check`. Poner en true cuando el equipo
# terminó la revisión (ver docs/regulatorio-bcra.md).
LEGAL_REVIEW_ACKNOWLEDGED=false