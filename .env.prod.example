# Ejemplo de variables de entorno para producción (docker-compose.prod.yml).
#
# Copiá este archivo a `.env.prod` y completá los valores. NO commitees el
# `.env.prod` con los secretos reales: está en el .gitignore.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Sin secretos reales: los valores de abajo son ejemplos o van vacíos.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=presto.example.com
DJANGO_ENV=production

# Base de datos
POSTGRES_DB=presto
POSTGRES_USER=presto
POSTGRES_PASSWORD=

# Redis (broker de Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Email: en modo demo los avisos de las notificaciones salen por consola, en los
# logs del worker. Para usar un SMTP de verdad, definí EMAIL_HOST (y las
# credenciales): el backend por defecto pasa a ser SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@presto.local

# Modo demo: con DEMO_MODE=true la aplicación corre como demostración (el dinero
# es simulado, el system check ledger.E001 lo permite y el email sale por
# consola, en los logs del worker). Sin DEMO_MODE, el dinero simulado queda
# bloqueado en producción.
DEMO_MODE=false

# Depósitos y retiros simulados: siempre apagados en producción (salvo demo)
LEDGER_SIMULATED_DEPOSITS_ENABLED=false

# Proveedor de pagos (ADR 0008). En producción va `mercadopago`: el simulado no
# mueve plata real. Las credenciales las da Mercado Pago: el access token y el
# secreto de firma de los webhooks.
PAYMENTS_PROVIDER=mercadopago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
# URL pública del endpoint de webhooks de la API (por ejemplo
# https://presto.example.com/api/v1/payments/webhooks/mercadopago/).
MERCADO_PAGO_WEBHOOK_URL=
PAYMENTS_WEBHOOK_MAX_AGE_SECONDS=300
PAYMENTS_HTTP_TIMEOUT=10

# Refresh token en cookie httpOnly (ADR 0014): en producción la cookie va
# siempre con `Secure`, así que acá no hace falta activarlo.
# `Lax` sirve si el front y la API comparten sitio (por ejemplo
# presto.example.com y api.presto.example.com). Si el front vive en otro
# dominio (por ejemplo un deploy en Vercel), la cookie tiene que ir con
# `None` para que el navegador la mande en las peticiones cross-site; en ese
# caso `Secure` ya está activo.
JWT_REFRESH_COOKIE_NAME=presto_refresh
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
# Con el front en Vercel (otro sitio distinto del de la API) la cookie tiene
# que ir con `SameSite=None` y `Secure`, o el navegador no la manda en el
# refresh. Si el front y la API comparten sitio, `Lax` también sirve.
JWT_REFRESH_COOKIE_SAMESITE=None
JWT_REFRESH_COOKIE_SECURE=true

# Reintentos de los avisos por email (ADR 0013)
NOTIFICATIONS_RETRY_BASE_SECONDS=60

# Dominio del proxy inverso (perfil `proxy` de docker-compose.prod.yml).
# Con el perfil activo Caddy pide el certificado TLS solo y es el único
# servicio que publica puertos 80/443.
# Es el subdominio completo, sin https:// ni puerto. Con DuckDNS, algo como
# presto-demo.duckdns.org
DOMAIN="

# Backups diarios de PostgreSQL (perfil `backup`): cuántos archivos se conservan
BACKUP_KEEP=14

# Proxy inverso y CORS
# CORS: los orígenes del front (Vercel), separados por comas. Sin `*`: la
# lista vacía significa que ningún origen puede llamar a la API.
# La API permite credenciales porque el refresh token viaja en una cookie
# httpOnly (ADR 0014) y el header `Idempotency-Key` está permitido porque las
# operaciones de dinero lo exigen.
CORS_ALLOWED_ORIGINS=https://presto.example.com
# La API es de solo lectura por token JWT: el admin se usa desde el mismo
# origen, así que la API no necesita confines de CSRF.
CSRF_TRUSTED_ORIGINS=https://presto.example.com

# HSTS: los navegadores guardan la política en el dominio. El valor por
# defecto es un año. El preload queda apagado a propósito: es irreversible.
SECURE_HSTS_SECONDS=31536000

# Sentry (opcional)
SENTRY_DSN=

# Gunicorn: cantidad de workers del servidor web.
# Con 6 GB de RAM: 2. Con 12 GB: 4. Cada worker es un proceso de Django.
GUNICORN_WORKERS=3

# Celery: cantidad de procesos del worker (las tareas son de E/S, así que
# aguantan más concurrencia que el web).
# Con 6 GB de RAM: 2. Con 12 GB: 4.
CELERY_WORKER_CONCURRENCY=2

# Revisión legal y de PLA/FT: recordatorio (ver docs/regulatorio-bcra.md).
# Mientras esté en false, el system check `legal.W001` avisa en `manage.py
# check --deploy` y `/api/v1/meta/` informa que la revisión sigue pendiente.
# Poner en true solo cuando el equipo terminó la revisión.
LEGAL_REVIEW_ACKNOWLEDGED=false
